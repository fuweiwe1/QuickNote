<Window x:Class="QuickNote.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="QuickNote · 晾一会" Width="1160" Height="426" WindowStyle="None"
 ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
 ShowInTaskbar="False" Topmost="True" AllowDrop="True"
 SourceInitialized="OnSourceInitialized" Closing="OnClosing" Drop="OnFileDrop" DragOver="OnFileDragOver">
 <Grid x:Name="Root">
  <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /><RowDefinition Height="44" /></Grid.RowDefinitions>
  <Border x:Name="Toolbar" VerticalAlignment="Top" Margin="24,8,24,0" CornerRadius="16"
          Background="#FFF9F5EB" BorderBrush="#FFF2E9D9" BorderThickness="1" Padding="10,7">
   <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.13" /></Border.Effect>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" MouseLeftButtonDown="OnMove" Cursor="SizeAll" Background="Transparent">
     <Border Background="#DCE4D0" Width="29" Height="29" CornerRadius="9" Margin="0,0,9,0">
      <TextBlock Text="∿" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#597353" />
     </Border>
     <TextBlock Text="晾一会" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
     <TextBlock x:Name="CountLabel" Text="  /  给灵感一个落脚点" FontSize="11" Foreground="#8B8F80" VerticalAlignment="Center" />
    </StackPanel>
    <Border Grid.Column="1" Background="#EEEDE5" CornerRadius="9" Margin="0,0,12,0" Padding="10,5">
     <Grid>
     <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" FontFamily="Microsoft YaHei UI"
              FontSize="12" VerticalContentAlignment="Center" Foreground="#49514A" TextChanged="OnSearch"
              ToolTip="搜索文字或图片名称；Esc 清空" KeyDown="OnSearchKeyDown" AutomationProperties.Name="搜索便签" />
      <TextBlock Text="搜索便签…" FontSize="11" Foreground="#969A8D" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
     </Grid>
    </Border>
    <StackPanel Grid.Column="2" Orientation="Horizontal">
     <Button x:Name="PinButton" Content="置顶 ✓" FontSize="11" Click="OnToggleTopmost" ToolTip="切换是否悬浮在其他窗口上方" />
     <Button x:Name="FoldButton" Content="收起" FontSize="11" Click="OnFold" ToolTip="收起或展开便签" />
     <Button Content="···" FontSize="18" Padding="9,0" Click="OnMenu" ToolTip="更多操作" />
     <Button Content="—" Click="OnHide" ToolTip="隐藏到托盘 · Ctrl+Alt+空格 呼出" AutomationProperties.Name="隐藏到托盘" />
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1" x:Name="LineArea">
   <Path Data="M 32,18 Q 550,55 1128,18" Stretch="Fill" Height="24" Margin="22,10,22,0"
         VerticalAlignment="Top" Stroke="#6E5640" StrokeThickness="3" MouseLeftButtonDown="OnMove" Cursor="SizeAll">
    <Path.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="2" Opacity="0.15" /></Path.Effect>
   </Path>
   <Ellipse Width="10" Height="10" Fill="#A18462" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,7,0,0" />
   <Ellipse Width="10" Height="10" Fill="#A18462" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,18,0" />
   <Grid Margin="38,0,38,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="158" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Grid VerticalAlignment="Top" Margin="0,14,0,0">
     <Border Background="#D6C9AE" Width="132" Height="192" CornerRadius="3" Margin="8,20,0,0" RenderTransformOrigin="0.5,0">
      <Border.RenderTransform><RotateTransform Angle="-3" /></Border.RenderTransform>
     </Border>
     <Button x:Name="NotebookButton" Width="136" Height="196" Margin="0,19,0,0" Padding="0" Click="OnCapture" ToolTip="点击读取剪贴板文字或图片 · Ctrl+Alt+V" AutomationProperties.Name="从剪贴板夹上新便签">
      <Button.Template><ControlTemplate TargetType="Button">
       <Border x:Name="Pad" Background="#FBF7E9" CornerRadius="3" BorderBrush="#DED6BE" BorderThickness="1" Padding="12">
        <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="5" Opacity="0.15" /></Border.Effect>
        <Grid>
         <Grid.RowDefinitions><RowDefinition Height="20" /><RowDefinition Height="*" /><RowDefinition Height="36" /></Grid.RowDefinitions>
         <TextBlock Text="随 手 夹" FontSize="10" Foreground="#8D947D" HorizontalAlignment="Center" />
         <StackPanel Grid.Row="1" VerticalAlignment="Center">
          <TextBlock Text="＋" FontSize="36" FontWeight="Light" Foreground="#7C8C69" HorizontalAlignment="Center" />
          <TextBlock Text="把此刻，晾起来" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,10" />
          <Rectangle Height="1" Fill="#E4DFC9" Margin="0,3" /><Rectangle Height="1" Fill="#E4DFC9" Margin="0,6" />
         </StackPanel>
         <TextBlock Grid.Row="2" Text="先复制，再点这里&#10;文字 · 图片" TextAlignment="Center" FontSize="10" Foreground="#959680" LineHeight="17" />
        </Grid>
       </Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pad" Property="Background" Value="#FFFFF6" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Pad" Property="Opacity" Value="0.7" /></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></Button.Template>
     </Button>
     <Border Width="18" Height="35" Background="#B38E64" CornerRadius="3" VerticalAlignment="Top" HorizontalAlignment="Center" IsHitTestVisible="False">
      <Rectangle Width="2" Height="24" Fill="#8E6A47" />
     </Border>
    </Grid>
    <ScrollViewer x:Name="NotesScroll" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Padding="16,0,24,0" PreviewMouseWheel="OnNotesWheel" PanningMode="HorizontalOnly">
     <StackPanel x:Name="NotesPanel" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,14,0,0" />
    </ScrollViewer>
    <Border x:Name="EmptyPanel" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="30,85,20,0" Background="#F5F8F5EC" CornerRadius="16" Padding="28,22" IsHitTestVisible="False">
     <StackPanel>
      <TextBlock x:Name="EmptyTitle" Text="让零散的东西，有处可放。" FontSize="19" FontWeight="Light" />
      <TextBlock x:Name="EmptyDescription" Text="复制一句话或一张图，点左边的草稿本。&#10;用时取下，用完撕掉。" FontSize="12" Foreground="#868A7D" LineHeight="24" Margin="0,12,0,0" />
     </StackPanel>
    </Border>
   </Grid>
   <Grid x:Name="TearOverlay" IsHitTestVisible="False" ClipToBounds="False" />
  </Grid>
  <Grid Grid.Row="2" Margin="36,0,36,0">
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
    <Button Content="‹" FontSize="20" Click="OnScrollLeft" ToolTip="向左翻看" Padding="10,0" Background="#EBF9F5EB" />
    <Button Content="›" FontSize="20" Click="OnScrollRight" ToolTip="向右翻看" Padding="10,0" Margin="4,0,0,0" Background="#EBF9F5EB" />
   </StackPanel>
   <Border x:Name="Toast" Visibility="Collapsed" Background="#F4323E35" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Top" Padding="14,7">
    <StackPanel Orientation="Horizontal">
     <TextBlock x:Name="ToastLabel" Foreground="#FFFBF2" FontSize="12" VerticalAlignment="Center" />
     <Button x:Name="UndoButton" Content="撤销" Foreground="#D9EDB7" FontSize="12" Margin="10,-3,-5,-3" Click="OnUndo" Visibility="Collapsed" />
    </StackPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
