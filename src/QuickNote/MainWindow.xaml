<Window x:Class="QuickNote.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="QuickNote · 晾一会" Width="1200" Height="330" WindowStyle="None"
 ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
 ShowInTaskbar="False" ShowActivated="False" Topmost="True" AllowDrop="True"
 SourceInitialized="OnSourceInitialized" Closing="OnClosing" Closed="OnClosed"
 Drop="OnFileDrop" DragOver="OnFileDragOver" SizeChanged="OnLineSizeChanged">
 <Grid x:Name="Root" ClipToBounds="True">
  <Grid.RenderTransform><TranslateTransform x:Name="Slide" /></Grid.RenderTransform>
  <Canvas x:Name="LineArea" ClipToBounds="False">
   <Path x:Name="Rope" Stroke="#806246" StrokeThickness="2.5" MouseRightButtonUp="OnRopeMenu">
    <Path.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="2" Opacity="0.18" /></Path.Effect>
   </Path>
   <Ellipse Width="7" Height="7" Fill="#AA8764" Canvas.Left="0" Canvas.Top="8.5" IsHitTestVisible="False" />
   <Ellipse x:Name="RightAnchor" Width="7" Height="7" Fill="#AA8764" Canvas.Top="8.5" IsHitTestVisible="False" />
   <Grid x:Name="NotebookHost" Width="108" Height="168" Canvas.Left="24" Canvas.Top="12">
    <Border Background="#D9CCB2" Width="102" Height="146" CornerRadius="2" Margin="5,20,0,0" RenderTransformOrigin="0.5,0">
     <Border.RenderTransform><RotateTransform Angle="-3" /></Border.RenderTransform>
    </Border>
    <Button x:Name="NotebookButton" Width="108" Height="148" Margin="0,17,0,0" Padding="0" Click="OnCapture"
            MouseRightButtonUp="OnRopeMenu" ToolTip="收录剪贴板 · Ctrl+Alt+V" AutomationProperties.Name="从剪贴板夹上新便签">
     <Button.Template><ControlTemplate TargetType="Button">
      <Border x:Name="Pad" Background="#FBF7E9" CornerRadius="2" BorderBrush="#DED6BE" BorderThickness="1" Padding="12">
       <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="4" Opacity="0.15" /></Border.Effect>
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="19" /><RowDefinition Height="*" /><RowDefinition Height="24" /></Grid.RowDefinitions>
        <TextBlock Text="随 手 夹" FontSize="9" Foreground="#8D947D" HorizontalAlignment="Center" />
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
         <TextBlock Text="＋" FontSize="31" Foreground="#7C8C69" HorizontalAlignment="Center" />
         <Rectangle Height="1" Fill="#E4DFC9" Margin="0,8,0,0" /><Rectangle Height="1" Fill="#E4DFC9" Margin="0,9,0,0" />
        </StackPanel>
        <TextBlock Grid.Row="2" Text="文字 · 图片" FontSize="9" Foreground="#969783" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
       </Grid>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pad" Property="Background" Value="#FFFFF6" /></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Pad" Property="Opacity" Value="0.7" /></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate></Button.Template>
    </Button>
    <Border Width="14" Height="30" Background="#B38E64" CornerRadius="2" VerticalAlignment="Top" HorizontalAlignment="Center" IsHitTestVisible="False">
     <Rectangle Width="2" Height="21" Fill="#8E6A47" />
    </Border>
   </Grid>
   <Canvas x:Name="NotesPanel" Width="{Binding ActualWidth, ElementName=LineArea}" Height="{Binding ActualHeight, ElementName=LineArea}" ClipToBounds="False" />
  </Canvas>
  <Grid x:Name="TearOverlay" IsHitTestVisible="False" ClipToBounds="False" />
 </Grid>
</Window>
