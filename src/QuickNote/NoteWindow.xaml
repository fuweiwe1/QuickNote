<Window x:Class="QuickNote.NoteWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="展开便签 · QuickNote" Width="640" Height="580" MinWidth="400" MinHeight="340"
 WindowStartupLocation="CenterScreen" Background="#FAF7EE" PreviewKeyDown="OnKeyDown" Closing="OnClosing">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18">
   <TextBlock x:Name="Heading" Text="把灵感多留一会" FontSize="21" FontWeight="Light" />
   <TextBlock x:Name="Metadata" FontSize="11" Foreground="#8A8E81" Margin="0,7,0,0" />
  </StackPanel>
  <TextBox x:Name="Editor" Grid.Row="1" Background="#FFFCF5" BorderBrush="#E3DECE" Padding="14"
           AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
           FontFamily="Microsoft YaHei UI" FontSize="15" Foreground="#343C3C" MaxLength="100000"
           SpellCheck.IsEnabled="False" AutomationProperties.Name="便签全文" />
  <ScrollViewer x:Name="ImageScroll" Grid.Row="1" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
   <Image x:Name="FullImage" Stretch="Uniform" MouseWheel="OnImageWheel" ToolTip="Ctrl + 滚轮缩放图片" />
  </ScrollViewer>
  <Grid Grid.Row="2" Margin="0,16,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <TextBlock x:Name="Status" Text="Ctrl+Enter 保存 · Esc 关闭" FontSize="11" Foreground="#8A8E81" VerticalAlignment="Center" />
   <Button Grid.Column="1" Content="复制内容" Click="OnCopy" Padding="15,9" Margin="0,0,8,0" />
   <Button x:Name="SaveButton" Grid.Column="2" Content="保存便签" Click="OnSave" Background="#DEE7D1" Padding="18,9" />
  </Grid>
 </Grid>
</Window>
