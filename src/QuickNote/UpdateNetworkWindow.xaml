<Window x:Class="QuickNote.UpdateNetworkWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="更新网络设置" Width="470" Height="330" ResizeMode="NoResize" Background="#FAF7EE" WindowStartupLocation="CenterOwner">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <TextBlock Text="选择更新使用的网络" FontSize="19" Margin="0,0,0,18" />
  <RadioButton x:Name="SystemProxy" GroupName="UpdateProxy" Grid.Row="1" Content="跟随 Windows 系统代理（默认）" IsChecked="True" FontFamily="Microsoft YaHei UI" Margin="0,0,0,12" />
  <StackPanel Grid.Row="2">
   <RadioButton x:Name="CustomProxy" GroupName="UpdateProxy" Content="使用指定代理" FontFamily="Microsoft YaHei UI" Margin="0,0,0,10" />
   <TextBox x:Name="Address" FontFamily="Microsoft YaHei UI" FontSize="12" Padding="8" IsEnabled="{Binding IsChecked, ElementName=CustomProxy}" ToolTip="例如 http://127.0.0.1:7890，以你实际使用的代理地址为准" />
  </StackPanel>
  <TextBlock x:Name="Hint" Grid.Row="3" Text="仅用于检查和下载更新。如果浏览器使用单独的代理，请填写对应的实际代理地址；不要填写 GitHub 网址或账号密码。" TextWrapping="Wrap" FontSize="11" Foreground="#8A8E81" Margin="0,14,0,8" />
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="取消" Click="OnCancel" Margin="0,0,8,0" Padding="16,8" />
   <Button Content="保存并重试" Click="OnSave" Background="#DEE7D1" Padding="16,8" />
  </StackPanel>
 </Grid>
</Window>
