<UserControl x:Class="QuickNote.NoteCard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="154" Height="216" RenderTransformOrigin="0.5,0.06"
 MouseEnter="OnHover" MouseLeave="OnLeave" MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove"
 MouseLeftButtonUp="OnMouseUp" LostMouseCapture="OnLostCapture">
 <UserControl.RenderTransform><TransformGroup><ScaleTransform x:Name="CardScale" /><RotateTransform x:Name="CardRotation" /><TranslateTransform x:Name="CardOffset" /></TransformGroup></UserControl.RenderTransform>
 <Grid>
  <Border x:Name="Paper" Margin="0,20,0,0" CornerRadius="2" BorderThickness="1" BorderBrush="#18000000">
   <Border.Effect><DropShadowEffect x:Name="Shadow" BlurRadius="13" ShadowDepth="5" Opacity="0.16" Color="#31291F" /></Border.Effect>
   <Grid Margin="12,14,12,9">
    <Grid.RowDefinitions><RowDefinition Height="16" /><RowDefinition Height="*" /><RowDefinition Height="26" /></Grid.RowDefinitions>
    <Grid>
     <TextBlock x:Name="TypeLabel" FontSize="9" Foreground="#7C816E" FontWeight="SemiBold" />
     <TextBlock x:Name="DateLabel" FontSize="9" Foreground="#92927C" HorizontalAlignment="Right" />
    </Grid>
    <Grid Grid.Row="1" Margin="0,7,0,8" ClipToBounds="True">
     <TextBlock x:Name="TextPreview" FontSize="12" TextWrapping="Wrap" LineHeight="20" />
     <Border x:Name="ImageFrame" Visibility="Collapsed" Background="#20000000" CornerRadius="2"><Image x:Name="ImagePreview" Stretch="UniformToFill" /></Border>
    </Grid>
    <Grid Grid.Row="2">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <Button Content="展开" FontSize="10" Padding="0,4,8,4" HorizontalAlignment="Left" Click="OnOpen" ToolTip="查看完整内容 · 双击便签" />
     <Button x:Name="CopyButton" Grid.Column="1" Content="复制" FontSize="10" Padding="6,4" Background="#35FFFFFF" Click="OnCopy" />
     <Button Grid.Column="2" Content="×" FontSize="17" Padding="5,0" Margin="2,0,-5,0" Click="OnDelete" ToolTip="撕掉便签" AutomationProperties.Name="撕掉便签" />
    </Grid>
   </Grid>
  </Border>
  <Border Width="14" Height="30" CornerRadius="2" Background="#BC9871" VerticalAlignment="Top" HorizontalAlignment="Center" IsHitTestVisible="False">
   <Border.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="2" Opacity="0.2" /></Border.Effect>
   <Grid><Rectangle Width="2" Height="22" Fill="#8E6A47" /><Rectangle Height="2" Fill="#D9BF99" Margin="2,0" /></Grid>
  </Border>
 </Grid>
</UserControl>
